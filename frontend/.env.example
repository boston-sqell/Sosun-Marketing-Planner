VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# Cloud Run API backend URL
VITE_BACKEND_URL=http://localhost:5000

# App Check debug token for local dev (App Check is ENFORCED on Firestore).
# Leave empty on first run: the SDK prints a generated token to the browser
# console. Register it in Firebase Console -> App Check -> Apps -> Manage
# debug tokens, then paste it here so it persists across browser profiles.
VITE_APPCHECK_DEBUG_TOKEN=

# VAPID public key for Web Push Notifications.
# This is fetched from the backend at runtime, but can be set here as a fallback.
# Generate the key pair: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=
